{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // Run by hand, as each script's header or README says.
    "scripts/generate-summary-log-rules.mjs",
    "scripts/mongo-performance-test/*/benchmark-*.js"
  ],
  // Each module's callers reach past its interface until the modular-monolith
  // boundary lint covers it. Remove an entry once knip hints it is stale.
  "ignoreFiles": [
    "src/market-insights/index.js",
    "src/reports/index.js",
    "src/waste-balances/index.js"
  ],
  "ignoreDependencies": [
    // pino loads it by name as a transport target.
    "pino-pretty",
    // setup:husky imports it inside a `node -e` string, which knip cannot read.
    "husky",
    // Restored in https://github.com/DEFRA/epr-backend/pull/249 as likely needed
    // for MongoDB auth in deployed environments. Kept until a deployment shows
    // it is not.
    "aws4"
  ],
  // lint-staged runs it, and it comes from the system rather than npm.
  "ignoreBinaries": ["gitleaks"],
  // Knip makes every file reached through a package.json import alias an
  // entry, so without this it reports no unused export in most of the code.
  "includeEntryExports": true,
  // A stale ignore fails the build, so it is removed as soon as it is stale.
  "treatConfigHintsAsErrors": true,
  // @moduleBoundaryPending marks a module interface export whose callers still
  // reach past the interface. A tag on an export that is used fails the build.
  "tags": ["-moduleBoundaryPending"],
  "treatTagHintsAsErrors": true,
  // An export used in its own file is live code, not dead code.
  "ignoreExportsUsedInFile": true
}
